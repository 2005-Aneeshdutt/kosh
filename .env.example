# ── Razorpay ────────────────────────────────────────────────
# Get test keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# When true, Kosh uses realistic mock data and never calls the Razorpay API.
# Leave this true for demos — no keys required.
DEMO_MODE=true

# ── LLM provider (optional) ─────────────────────────────────
# If none is set, the agents fall back to deterministic templated copy so the
# whole app still runs fully offline. Configure ONE of the two options below to
# get live, model-authored reminders, summaries, forecasts, insights, and a
# retrieval-grounded "Ask your books" copilot.
#
# Option A — OpenRouter (OpenAI-compatible gateway). Takes priority when set.
#   Key: https://openrouter.ai/keys  ·  Models: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Option B — a direct Anthropic key.
ANTHROPIC_API_KEY=
KOSH_MODEL=claude-sonnet-5

# ── Server ──────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=sqlite:///./kosh.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Public URL for payment links in emails ──────────────────
# Reminder emails link to {KOSH_PUBLIC_URL}/pay/<invoice>. Localhost is fine for
# a same-machine demo. To let a phone / another device open the link, use an
# ngrok or deployed URL, e.g. https://kosh.ngrok.app
KOSH_PUBLIC_URL=http://localhost:8000

# ── Real email delivery (optional) ──────────────────────────
# Create a DEDICATED Gmail for Kosh, enable 2-Step Verification, then create an
# App Password (https://myaccount.google.com/apppasswords) and paste it below.
# (You can also configure all of this at runtime under Settings → Email.)
KOSH_SMTP_HOST=smtp.gmail.com
KOSH_SMTP_PORT=587
KOSH_SMTP_USER=your.kosh.account@gmail.com
KOSH_SMTP_PASSWORD=your16charapppassword
KOSH_SMTP_FROM=your.kosh.account@gmail.com
KOSH_SMTP_FROM_NAME=Artisan Coffee Co. (via Kosh)
# Deliver EVERY reminder/receipt to this one inbox (great for demos):
KOSH_MAIL_REDIRECT=aneeshdutt67@gmail.com
