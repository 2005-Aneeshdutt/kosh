# ── Razorpay ────────────────────────────────────────────────
# Get test keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# When true, Kosh uses realistic mock data and never calls the Razorpay API.
# Leave this true for demos — no keys required.
DEMO_MODE=true

# ── Claude API (optional) ───────────────────────────────────
# If unset, the agents fall back to deterministic templated copy so the
# whole app still runs fully offline. Set this to get live Claude-authored
# reminders, reconciliation summaries, forecasts, and payment insights.
ANTHROPIC_API_KEY=

# Model used by all four agents. Sonnet 5 is a strong, fast default.
KOSH_MODEL=claude-sonnet-5

# ── Server ──────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=sqlite:///./kosh.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
